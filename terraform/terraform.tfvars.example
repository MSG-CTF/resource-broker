# Existing Service Account attached to the central Broker VM or workload.
central_service_account_email = "msg-broker-controller@central-broker-project.iam.gserviceaccount.com"

# Add all target GCP Project IDs. Project names and numeric project numbers are
# not accepted here.
target_project_ids = [
  "target-project-01",
  "target-project-02",
  # ...add the remaining projects...
]

# Add every Cloud Billing account linked to the target projects. Multiple
# projects can share one Billing account, so each ID is listed only once.
target_billing_account_ids = [
  "000000-000000-000000",
  "111111-111111-111111",
  # ...add the remaining Cloud Billing account IDs...
]
