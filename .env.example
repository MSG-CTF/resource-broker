# Required by both the production baseline and local development.
POSTGRES_DB=broker
POSTGRES_USER=broker
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password
DATABASE_URL=postgresql+psycopg://broker:replace-with-the-url-encoded-database-password@db:5432/broker
ADMIN_ID=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN_TTL_SECONDS=28800
SCHEDULER_API_TOKEN=replace-with-a-separate-32-character-minimum-token
SCHEDULER_OBSERVATION_STALE_SECONDS=600
SCHEDULER_CANDIDATE_VALIDITY_SECONDS=30
SCHEDULER_RESERVATION_TTL_SECONDS=120
BOOTSTRAP_PUBLIC_BASE_URL=https://agents.mjsec.kr
BOOTSTRAP_JOB_TIMEOUT_SECONDS=7200
BOOTSTRAP_JOB_POLL_SECONDS=10
BOOTSTRAP_GCP_MAX_ACTIVE_ASSIGNMENTS_PER_ZONE=10

# Bootstrap uploads each k3s administrator kubeconfig to Broker. Broker stores
# only an encrypted blob and Runtime pulls it with a separate short-lived JWT.
K3S_CREDENTIAL_UPLOAD_TOKEN_SECRET=replace-with-a-bootstrap-upload-secret-at-least-32-bytes
K3S_CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-storage-secret-at-least-32-bytes
K3S_ADDRESS_SOURCE=public_ip
RUNTIME_API_TOKEN_SECRET=replace-with-a-runtime-api-secret-at-least-32-bytes
RUNTIME_API_TOKEN_SUBJECT=runtime

# Production baseline: only this private HTTP entry point is published.
BROKER_HTTP_BIND_ADDRESS=127.0.0.1
BROKER_HTTP_PORT=8080
BROKER_IMAGE=msg-resource-broker:latest
FRONTEND_IMAGE=msg-broker-admin:latest

# compose.agent-enrollment.yaml only. Initialize this directory with
# deploy/mtls/init-agent-ca.sh before starting the enrollment-enabled Broker.
AGENT_ENROLLMENT_CA_HOST_DIR=/etc/msg-broker/pki/agent-ca/enrollment-ca
AGENT_ENROLLMENT_CERTIFICATE_DAYS=75

# compose.dev.yaml only: loopback ports for local tools and Vite hot reload.
POSTGRES_PORT=5432
BROKER_PORT=8000
FRONTEND_PORT=5173

# Local Docker-only GCP ADC path. Do not set or mount this on GCE.
GCP_ADC_PATH=C:/Users/your-user/AppData/Roaming/gcloud/application_default_credentials.json

# AWS inventory and Bootstrap federation. The Broker obtains a Google ID token
# from the attached GCP Service Account and exchanges it for temporary Hub and
# per-account roles. Each target-account trust also requires its External ID.
# No AWS access key is stored or mounted.
AWS_FEDERATION_HUB_ROLE_ARN=arn:aws:iam::123456789012:role/MsgBrokerFederationHubRole
AWS_FEDERATION_AUDIENCE=msg-broker-aws
AWS_STS_REGION=us-east-1

# Azure inventory and Bootstrap use the attached GCP Service Account's Google
# OIDC ID token and each tenant's Entra Federated Credential. Tenant ID, Client
# ID, and Subscription IDs are non-secret Provider account configuration entered
# through the Admin API/UI. No Azure Client Secret is stored or mounted.
